# ─────────────────────────────────────────────────────────────────────────────
#  .env.example — copy this to .env and fill in your values
#  NEVER commit .env to git
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string
# Get from: Atlas dashboard → your cluster → Connect → Drivers → copy URI
MONGO_URI=mongodb+srv://stivatsa2007_db_user:55110932@cluster0.al30mmq.mongodb.net/cdvae?retryWrites=true&w=majority

# Database name
MONGO_DB=cdvae

# JWT secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_this_with_a_long_random_string

# JWT settings
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Path to model checkpoint
CHECKPOINT_PATH=cdvae_checkpoint_epoch_110.pt

# Allowed frontend origins (comma-separated, or * for all)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,null

# Server
HOST=0.0.0.0
PORT=8000
